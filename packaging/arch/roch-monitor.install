# This only prints. `rochmonitor setup` lets one user start Roch Monitor's root helper without a password,
# so whoever installs this runs it themselves, and removing the package leaves what they did in place.

post_install() {
  cat <<'END'
Roch Monitor asks for your password through pkexec when it reads the board voltages. To stop that, once:
  sudo rochmonitor setup
Installed from this package, setup names /usr/bin/rochmonitor itself, so updates keep it working.
END
}

post_upgrade() {
  # A setup made from a home install named a copy in /usr/local/bin, not this package's program.
  if [ -e /usr/local/bin/rochmonitor ]; then
    echo "Run 'sudo rochmonitor setup' once more so the password-free helper is this package's rochmonitor."
  fi
  return 0
}

post_remove() {
  local rule=/etc/polkit-1/rules.d/49-rochmonitor.rules
  if [ -e "$rule" ]; then
    echo "Still in place: $rule. It names a program that is gone, so it no longer does anything."
    echo "To remove it: sudo rm $rule"
  fi
  return 0
}
